# Copy this file to .env to override defaults. All values are optional;
# sensible defaults are used if a variable is not set. Never commit a real .env.

# Number of consecutive matching frames required before a gesture is
# confirmed as an event (debounce sensitivity). Higher = fewer false
# triggers but slower to react.
GESTURE_CONFIRM_FRAMES=8

# HTTP timeout (seconds) for outbound webhook POST requests.
WEBHOOK_TIMEOUT_SECONDS=5

# Python logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
